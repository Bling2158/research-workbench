# Copy this file to .env for local use, or set these in Vercel → Settings → Environment Variables.
# Never commit real values. Everything is optional except where noted.

# Login key for the web page (long random string, 32+ characters). If unset locally, one is generated in .data/access-token.
WORKBENCH_ACCESS_TOKEN=

# Chat models — set at least one to use the chat page.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Cloud storage (required on Vercel; leave empty locally to store data in .data/).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional: web search for the chat assistant (https://tavily.com). Literature search (OpenAlex) needs no key.
TAVILY_API_KEY=
OPENALEX_MAILTO=
WEB_SEARCH_DAILY_LIMIT=30

# Optional: limits and MCP access for local AI tools (long random strings).
DAILY_CHAT_LIMIT=40
MCP_REMOTE_TOKEN=
MCP_CODEX_TOKEN=
MCP_CLAUDE_TOKEN=

# Optional: site address if you use a custom domain.
APP_ORIGIN=
